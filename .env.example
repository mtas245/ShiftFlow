# Local-only values for the Docker Compose development environment.
# Do not reuse these credentials or secrets outside this disposable setup.
POSTGRES_DB=shiftflow_dev
POSTGRES_USER=shiftflow_dev_user
POSTGRES_PASSWORD=shiftflow_local_dev_only
PUBLIC_ORIGIN=https://localhost:8443
RATE_LIMIT_HMAC_SECRET=local-only-development-hmac-secret-not-for-production-0123456789

# Leave email delivery unconfigured locally unless using approved test credentials.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_ADDRESS=
